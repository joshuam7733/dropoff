# Drop Off · environment template. Copy to .env and fill in. Never commit .env.
#
# ── Browser app (public values; written into prototype/config.js by scripts/gen-config.mjs) ──────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / publishable key. NEVER put the service_role key here: gen-config.mjs refuses it.
SUPABASE_ANON_KEY=
# Where the web app is served (used for auth redirects and recipient tracking links)
APP_URL=https://app.example.com
# Optional map tiles for production (default: OpenStreetMap standard tiles, fair-use only)
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# ── Edge Function secrets (set with: supabase secrets set --env-file .env.functions) ─────────────────────
# These stay on the server. Do not copy them into the app or config.js.
# SUPABASE_SERVICE_ROLE_KEY is provided to Edge Functions automatically by Supabase.
APP_ORIGIN=https://app.example.com
CRON_SECRET=generate-a-long-random-string

# Payments: 'sandbox' until a provider contract exists. Must match the app setting payment_provider.
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=generate-a-long-random-string
# MTN MoMo (when PAYMENT_PROVIDER=mtn_momo). Sandbox: https://sandbox.momodeveloper.mtn.com, currency EUR.
MTN_MOMO_BASE_URL=
MTN_MOMO_TARGET_ENV=mtnuganda
MTN_MOMO_CURRENCY=UGX
MTN_MOMO_COLLECTION_KEY=
MTN_MOMO_COLLECTION_USER=
MTN_MOMO_COLLECTION_API_KEY=
MTN_MOMO_DISBURSEMENT_KEY=
MTN_MOMO_DISBURSEMENT_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# SMS (Africa's Talking): OTP codes via the Send SMS hook, recipient updates via sms-dispatch.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
SEND_SMS_HOOK_SECRET=v1,whsec_from_the_supabase_dashboard
SEND_SMS_HOOK_URI=https://YOUR-PROJECT-REF.supabase.co/functions/v1/send-sms-hook

# Google sign-in (Supabase Dashboard → Authentication → Providers → Google, or config.toml)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
